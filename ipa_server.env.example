# Copy to a protected environment file on the dedicated HTTPS server.
IPA_HOST=0.0.0.0
IPA_PORT=8788
IPA_DATA_DIR=/data

# Use a Google App Password for this mailbox. Never use the normal Gmail password.
GMAIL_SMTP_USER=your-game-mailbox@gmail.com
GMAIL_SMTP_APP_PASSWORD=replace-with-16-character-app-password
GMAIL_FROM_NAME=Tu Tiên Giới
