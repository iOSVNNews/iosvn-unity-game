# Copy to a protected environment file on the dedicated HTTPS server.
IPA_HOST=0.0.0.0
IPA_PORT=8788
IPA_DATA_DIR=/data
IPA_PUBLIC_API_URL=https://tutien.iosvn.com.vn/ipa/api
IPA_TRUSTED_PROXY_IP=172.26.2.254

# Use a Google App Password for this mailbox. Never use the normal Gmail password.
GMAIL_SMTP_USER=your-game-mailbox@gmail.com
GMAIL_SMTP_APP_PASSWORD=replace-with-16-character-app-password
GMAIL_FROM_NAME=Tu Tiên Giới

# Optional provider linking. Secrets stay on the server, never in the Unity app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Set the supported Graph API version selected for your Facebook app.
FACEBOOK_GRAPH_VERSION=
